{
  "name": "finditviral",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "smoke": "node scripts/verify-production.mjs",
    "smoke:web": "node scripts/verify-production.mjs --web-only",
    "deploy": "npm run build && wrangler pages deploy ./dist --project-name finditviral --branch main"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.2.7",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/fredoka": "^5.2.10",
    "@fontsource-variable/gabarito": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/nunito": "^5.2.7",
    "@fontsource-variable/quicksand": "^5.2.10",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@supabase/supabase-js": "^2.110.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.17",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
