{
  "name": "finditviral",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build",
    "check:worker": "tsc --noEmit --project workers/interest-digest/tsconfig.json",
    "test:worker": "vitest run --root workers/interest-digest",
    "check:content-moderator": "tsc --noEmit --project workers/content-moderator/tsconfig.json",
    "test:content-moderator": "vitest run --root workers/content-moderator",
    "types:content-moderator": "wrangler types workers/content-moderator/worker-configuration.d.ts --config workers/content-moderator/wrangler.jsonc --env-file workers/content-moderator/.dev.vars.example",
    "check:trend-engine": "tsc --noEmit --project workers/trend-engine/tsconfig.json",
    "test:trend-engine": "vitest run --config workers/trend-engine/vitest.config.ts",
    "types:trend-engine": "wrangler types workers/trend-engine/worker-configuration.d.ts --config workers/trend-engine/wrangler.jsonc --env-file workers/trend-engine/.dev.vars.example",
    "migrate:trend-engine:local": "wrangler d1 migrations apply finditviral-trend-engine --local --config workers/trend-engine/wrangler.jsonc",
    "dev:trend-engine": "wrangler dev --local --test-scheduled --config workers/trend-engine/wrangler.jsonc",
    "check:all": "npm run lint && npm test && npm run build && npm run check:worker && npm run test:worker && npm run check:content-moderator && npm run test:content-moderator && npm run types:content-moderator -- --check && npm run types:trend-engine -- --check && npm run check:trend-engine && npm run test:trend-engine",
    "smoke": "node scripts/verify-production.mjs",
    "smoke:web": "node scripts/verify-production.mjs --web-only",
    "deploy": "npm run build && wrangler pages deploy ./dist --project-name finditviral --branch main"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.110.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.17",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
