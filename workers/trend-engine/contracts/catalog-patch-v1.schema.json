{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finditviral.com/contracts/trend-engine/catalog-patch-v1.schema.json",
  "title": "FindItViral Catalog Patch V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "generated_at",
    "target",
    "mode",
    "score_version",
    "checksum",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "patch_id": {
      "type": "string",
      "pattern": "^patch_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "target": { "const": "finditviral" },
    "mode": { "enum": ["shadow", "review", "autopilot"] },
    "score_version": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "sequence",
        "action",
        "candidate_id",
        "idempotency_key",
        "depends_on",
        "before",
        "after",
        "reason",
        "reversible"
      ],
      "properties": {
        "operation_id": { "type": "string", "pattern": "^op_[0-9a-f]{24}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "action": { "enum": ["ensure_trend", "add_product"] },
        "candidate_id": { "type": "string", "pattern": "^candidate_[0-9a-f]{24}$" },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^op_" }
        },
        "before": {
          "oneOf": [
            { "type": "null" },
            { "type": "object" }
          ]
        },
        "after": { "type": "object" },
        "reason": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "confidence", "state", "policy_version", "evidence_urls"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 100 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "state": { "enum": ["candidate", "emerging", "trending", "cooling", "archived"] },
            "policy_version": { "type": "string", "minLength": 1 },
            "evidence_urls": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        },
        "reversible": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "ensure_trend" } } },
          "then": {
            "properties": {
              "before": { "type": "null" },
              "after": { "$ref": "#/$defs/ensureTrendAfter" },
              "reversible": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "add_product" } } },
          "then": {
            "properties": {
              "before": { "type": "null" },
              "after": { "$ref": "#/$defs/addProductAfter" },
              "reversible": { "const": true }
            }
          }
        }
      ]
    },
    "ensureTrendAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "description", "is_active"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 90 },
        "description": { "type": ["string", "null"], "maxLength": 500 },
        "is_active": { "const": true }
      }
    },
    "addProductAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_candidate_id", "trend_slug", "name", "slug", "brand", "category",
        "search_terms", "availability_status", "release_date", "source_url",
        "is_active", "rollback_strategy"
      ],
      "properties": {
        "engine_candidate_id": { "type": "string", "pattern": "^candidate_[0-9a-f]{24}$" },
        "trend_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 90 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 90 },
        "brand": { "type": ["string", "null"], "maxLength": 100 },
        "category": { "type": ["string", "null"], "maxLength": 100 },
        "search_terms": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "availability_status": {
          "enum": ["available", "backorder", "preorder", "announced", "limited"]
        },
        "release_date": { "type": ["string", "null"], "format": "date" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "is_active": { "const": true },
        "rollback_strategy": { "const": "soft_deactivate" }
      }
    }
  }
}
